# Copie a .env y ajuste. Nunca suba .env al repositorio.
DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
# Clave distinta para seudonimizar documentos de pacientes (no cambiarla después de cargar RIPS/facturación)
PSEUDONIMO_KEY=otra-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=costos.mihospital.gov.co,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://costos.mihospital.gov.co
POSTGRES_PASSWORD=cambie-esta-clave
# Ponga 0 solo si la red interna no tiene certificado HTTPS (no recomendado)
USAR_HTTPS=1
SECURE_SSL_REDIRECT=1
CARGA_MAX_MB=25
SESSION_COOKIE_AGE=1800
